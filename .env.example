# 이 파일은 "양식"입니다. 실제 키를 여기에 넣지 마세요 — git 에 그대로 올라갑니다.
# 복사해서 .env 를 만들고, 키는 .env 에만 넣습니다 (.env 는 .gitignore 대상).
#
#   cp .env.example .env
#
# 공공데이터포털 인증키 (https://www.data.go.kr) — 두 서비스에 모두 사용
# 인코딩 키·디코딩 키 어느 쪽을 넣어도 동작한다.
DATA_GO_KR_SERVICE_KEY=

# OpenAI
OPENAI_API_KEY=

# GPT-5 계열의 temperature 지원 여부: auto | on | off
# scripts/probe_temperature.py 로 한 번 확인한 뒤 고정하는 것을 권장한다.
PETPAL_TEMPERATURE=on

# GPT-5/o-시리즈 reasoning_effort: minimal | low | medium | high
# 분류·구조화 응답처럼 깊은 추론이 필요 없는 호출의 지연을 줄인다(기본값 minimal).
PETPAL_REASONING_EFFORT=minimal
